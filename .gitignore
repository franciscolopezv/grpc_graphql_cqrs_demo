# =============================================================================
# Platform Infrastructure .gitignore
# =============================================================================

# -----------------------------------------------------------------------------
# Environment and Configuration
# -----------------------------------------------------------------------------
# Environment files (keep .env.template for reference)
.env
.env.local
.env.development
.env.staging
.env.production
.env.test

# Configuration backups (created by registration scripts)
config/*.backup.*
*.backup.*

# Apollo Studio credentials
.apollo/
apollo.config.js

# -----------------------------------------------------------------------------
# Node.js and npm
# -----------------------------------------------------------------------------
# Dependencies
node_modules/
npm-debug.log*
yarn-debug.log*
yarn-error.log*
lerna-debug.log*

# Runtime data
pids
*.pid
*.seed
*.pid.lock

# Coverage directory used by tools like istanbul
coverage/
*.lcov

# nyc test coverage
.nyc_output

# Grunt intermediate storage
.grunt

# Bower dependency directory
bower_components

# node-waf configuration
.lock-wscript

# Compiled binary addons
build/Release

# Dependency directories
jspm_packages/

# TypeScript cache
*.tsbuildinfo

# Optional npm cache directory
.npm

# Optional eslint cache
.eslintcache

# Microbundle cache
.rpt2_cache/
.rts2_cache_cjs/
.rts2_cache_es/
.rts2_cache_umd/

# Optional REPL history
.node_repl_history

# Output of 'npm pack'
*.tgz

# Yarn Integrity file
.yarn-integrity

# parcel-bundler cache
.cache
.parcel-cache

# Next.js build output
.next

# Nuxt.js build / generate output
.nuxt
dist

# Gatsby files
.cache/
public

# Storybook build outputs
.out
.storybook-out

# -----------------------------------------------------------------------------
# Docker and Container Data
# -----------------------------------------------------------------------------
# Docker volumes and data
docker-data/
volumes/

# Docker Compose override files
docker-compose.override.yml
docker-compose.local.yml
docker-compose.dev.yml

# Container logs
*.log

# -----------------------------------------------------------------------------
# Database and Persistent Data
# -----------------------------------------------------------------------------
# PostgreSQL data
postgres-data/
pgdata/

# Kafka data
kafka-data/
kafka-logs/
zookeeper-data/
zookeeper-logs/

# Database dumps
*.sql
*.dump
*.backup

# -----------------------------------------------------------------------------
# Testing
# -----------------------------------------------------------------------------
# Test results
test-results/
test-reports/
junit.xml

# Jest coverage
coverage/

# Test generated files
test_*_integration.sh
rollback_*.sh

# Temporary test files
/tmp/
temp/

# -----------------------------------------------------------------------------
# IDE and Editor Files
# -----------------------------------------------------------------------------
# VSCode
.vscode/
!.vscode/settings.json
!.vscode/tasks.json
!.vscode/launch.json
!.vscode/extensions.json

# IntelliJ IDEA
.idea/
*.iws
*.iml
*.ipr

# Sublime Text
*.sublime-project
*.sublime-workspace

# Vim
*.swp
*.swo
*~

# Emacs
*~
\#*\#
/.emacs.desktop
/.emacs.desktop.lock
*.elc
auto-save-list
tramp
.\#*

# -----------------------------------------------------------------------------
# Operating System Files
# -----------------------------------------------------------------------------
# macOS
.DS_Store
.AppleDouble
.LSOverride
Icon
._*
.DocumentRevisions-V100
.fseventsd
.Spotlight-V100
.TemporaryItems
.Trashes
.VolumeIcon.icns
.com.apple.timemachine.donotpresent
.AppleDB
.AppleDesktop
Network Trash Folder
Temporary Items
.apdisk

# Windows
Thumbs.db
Thumbs.db:encryptable
ehthumbs.db
ehthumbs_vista.db
*.tmp
*.temp
Desktop.ini
$RECYCLE.BIN/
*.cab
*.msi
*.msix
*.msm
*.msp
*.lnk

# Linux
*~
.fuse_hidden*
.directory
.Trash-*
.nfs*

# -----------------------------------------------------------------------------
# Logs and Monitoring
# -----------------------------------------------------------------------------
# Application logs
logs/
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# Runtime logs
pids
*.pid
*.seed
*.pid.lock

# Monitoring and metrics
metrics/
traces/

# -----------------------------------------------------------------------------
# Security and Secrets
# -----------------------------------------------------------------------------
# API keys and secrets
secrets/
*.key
*.pem
*.p12
*.pfx
*.crt
*.cer
*.der

# SSL certificates
ssl/
certs/

# Kubernetes secrets
k8s-secrets/

# -----------------------------------------------------------------------------
# Build and Distribution
# -----------------------------------------------------------------------------
# Build outputs
build/
dist/
out/

# Compiled files
*.com
*.class
*.dll
*.exe
*.o
*.so

# Archives
*.7z
*.dmg
*.gz
*.iso
*.jar
*.rar
*.tar
*.zip

# -----------------------------------------------------------------------------
# GraphQL and Apollo
# -----------------------------------------------------------------------------
# Apollo Studio cache
.apollo/

# Generated GraphQL files
generated/
__generated__/

# Schema composition outputs
supergraph-*.graphql
composed-schema.graphql

# -----------------------------------------------------------------------------
# Infrastructure as Code
# -----------------------------------------------------------------------------
# Terraform
*.tfstate
*.tfstate.*
.terraform/
.terraform.lock.hcl
terraform.tfvars
*.tfvars

# Pulumi
Pulumi.*.yaml
.pulumi/

# Ansible
*.retry

# -----------------------------------------------------------------------------
# Monitoring and Observability
# -----------------------------------------------------------------------------
# Prometheus data
prometheus-data/

# Grafana data
grafana-data/

# Jaeger traces
jaeger-data/

# -----------------------------------------------------------------------------
# Development Tools
# -----------------------------------------------------------------------------
# Rover CLI cache
.rover/

# GraphQL Code Generator
codegen.yml

# -----------------------------------------------------------------------------
# Project Specific
# -----------------------------------------------------------------------------
# Generated test scripts (created by registration scripts)
test_*_apollo.sh
test_*_integration.sh
rollback_*.sh

# Temporary service registration files
/tmp/new_subgraph.yaml

# Local development overrides
docker-compose.local.yml
config/router.local.yaml

# Service discovery cache
service-cache/

# Schema validation reports
schema-validation-*.json

# Performance test results
performance-results/

# Load test data
load-test-data/

# -----------------------------------------------------------------------------
# Documentation Build
# -----------------------------------------------------------------------------
# Documentation build outputs
docs/_build/
docs/build/
site/

# Markdown processors
.mdx-data/

# -----------------------------------------------------------------------------
# Miscellaneous
# -----------------------------------------------------------------------------
# Temporary files
tmp/
temp/
.tmp/

# Cache directories
.cache/
cache/

# Lock files (keep package-lock.json for reproducible builds)
# yarn.lock (uncomment if using npm instead of yarn)

# Editor directories and files
.vscode/
.idea/
*.swp
*.swo

# OS generated files
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
ehthumbs.db
Thumbs.db

# =============================================================================
# Keep These Files (Explicitly Track Important Files)
# =============================================================================
# Keep template files
!.env.template
!config/router.yaml.template
!docker-compose.template.yml

# Keep example configurations
!examples/
!docs/examples/

# Keep important documentation
!README*.md
!docs/
!*.md

# Keep scripts
!scripts/
!*.sh

# Keep configuration templates
!config/*.template.*
!k8s/*.template.yaml
.kiro