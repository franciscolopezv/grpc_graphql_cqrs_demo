# =============================================================================
# Platform Infrastructure Environment Configuration
# =============================================================================
# This file contains all environment variables required for the platform
# infrastructure services. Copy this file to .env and modify values as needed.
#
# Deployment Environments:
# - development: Local development with default values
# - staging: Pre-production environment with external service URLs
# - production: Production environment with secure credentials and monitoring
# =============================================================================

# -----------------------------------------------------------------------------
# PostgreSQL Database Configuration
# -----------------------------------------------------------------------------
# Shared PostgreSQL instance for all domain services
# Required for: Products service, Ratings service, Platform services

# Database connection parameters
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_HOST=postgres
POSTGRES_PORT=5432

# Multiple database creation (comma-separated list)
# Each domain gets its own database for data isolation
POSTGRES_MULTIPLE_DATABASES=products_db,ratings_db,platform_db

# Database connection pool settings (optional)
# POSTGRES_MAX_CONNECTIONS=100
# POSTGRES_SHARED_BUFFERS=256MB

# -----------------------------------------------------------------------------
# GraphQL Gateway Configuration (Apollo Router)
# -----------------------------------------------------------------------------
# Central GraphQL endpoint that composes subgraph schemas

# Gateway server configuration
GRAPHQL_GATEWAY_PORT=4000

# Subgraph service URLs - Update these for different environments
# Development: Use localhost or service names
# Staging/Production: Use actual service URLs
PRODUCTS_SERVICE_URL=http://products-service:8081
RATINGS_SERVICE_URL=http://ratings-service:8082

# Apollo Router configuration paths (container paths)
APOLLO_ROUTER_SUPERGRAPH_PATH=/etc/router/supergraph.graphql
APOLLO_ROUTER_CONFIG_PATH=/etc/router/router.yaml

# Schema polling configuration
# APOLLO_ROUTER_POLL_INTERVAL=30s
# APOLLO_ROUTER_TIMEOUT=10s

# -----------------------------------------------------------------------------
# Logging Configuration
# -----------------------------------------------------------------------------
# Logging levels for Apollo Router and Rust components
# Options: error, warn, info, debug, trace

APOLLO_ROUTER_LOG=info
RUST_LOG=info

# Application logging (if needed by domain services)
# LOG_LEVEL=info
# LOG_FORMAT=json

# -----------------------------------------------------------------------------
# Apache Kafka Configuration
# -----------------------------------------------------------------------------
# Message bus for inter-service communication and event streaming

# Kafka broker configuration
KAFKA_BROKER_ID=1
KAFKA_ZOOKEEPER_CONNECT=zookeeper:2181

# Kafka listener configuration
KAFKA_LISTENER_SECURITY_PROTOCOL_MAP=PLAINTEXT:PLAINTEXT,PLAINTEXT_HOST:PLAINTEXT
KAFKA_ADVERTISED_LISTENERS=PLAINTEXT://kafka:29092,PLAINTEXT_HOST://localhost:9092

# Kafka replication and transaction settings
KAFKA_OFFSETS_TOPIC_REPLICATION_FACTOR=1
KAFKA_TRANSACTION_STATE_LOG_MIN_ISR=1
KAFKA_TRANSACTION_STATE_LOG_REPLICATION_FACTOR=1
KAFKA_GROUP_INITIAL_REBALANCE_DELAY_MS=0

# JMX monitoring configuration
KAFKA_JMX_PORT=9101
KAFKA_JMX_HOSTNAME=localhost

# Topic management
KAFKA_AUTO_CREATE_TOPICS_ENABLE=true

# Client connection (for domain services)
KAFKA_BOOTSTRAP_SERVERS=kafka:29092

# -----------------------------------------------------------------------------
# Zookeeper Configuration
# -----------------------------------------------------------------------------
# Coordination service for Kafka cluster

ZOOKEEPER_CLIENT_PORT=2181
ZOOKEEPER_TICK_TIME=2000

# -----------------------------------------------------------------------------
# Health Check Configuration
# -----------------------------------------------------------------------------
# Health check settings for all services

HEALTH_CHECK_INTERVAL=30s
HEALTH_CHECK_TIMEOUT=10s
HEALTH_CHECK_RETRIES=3

# -----------------------------------------------------------------------------
# Network Configuration
# -----------------------------------------------------------------------------
# Docker network settings

NETWORK_NAME=platform-infrastructure
NETWORK_DRIVER=bridge

# -----------------------------------------------------------------------------
# Environment-Specific Overrides
# -----------------------------------------------------------------------------
# Uncomment and modify these sections based on your deployment environment

# DEVELOPMENT ENVIRONMENT
# Use these settings for local development
# POSTGRES_PASSWORD=dev_password
# PRODUCTS_SERVICE_URL=http://localhost:8081
# RATINGS_SERVICE_URL=http://localhost:8082
# APOLLO_ROUTER_LOG=debug
# RUST_LOG=debug

# STAGING ENVIRONMENT
# Use these settings for staging deployment
# POSTGRES_PASSWORD=staging_secure_password
# PRODUCTS_SERVICE_URL=https://products-staging.company.com
# RATINGS_SERVICE_URL=https://ratings-staging.company.com
# APOLLO_ROUTER_LOG=info
# RUST_LOG=warn

# PRODUCTION ENVIRONMENT
# Use these settings for production deployment
# POSTGRES_PASSWORD=production_secure_password_from_secrets_manager
# PRODUCTS_SERVICE_URL=https://products.company.com
# RATINGS_SERVICE_URL=https://ratings.company.com
# APOLLO_ROUTER_LOG=warn
# RUST_LOG=error
# KAFKA_OFFSETS_TOPIC_REPLICATION_FACTOR=3
# KAFKA_TRANSACTION_STATE_LOG_REPLICATION_FACTOR=3

# -----------------------------------------------------------------------------
# Security Configuration (Production)
# -----------------------------------------------------------------------------
# Additional security settings for production environments

# SSL/TLS Configuration (uncomment for production)
# KAFKA_SSL_KEYSTORE_LOCATION=/etc/kafka/ssl/kafka.keystore.jks
# KAFKA_SSL_KEYSTORE_PASSWORD=keystore_password
# KAFKA_SSL_KEY_PASSWORD=key_password
# KAFKA_SSL_TRUSTSTORE_LOCATION=/etc/kafka/ssl/kafka.truststore.jks
# KAFKA_SSL_TRUSTSTORE_PASSWORD=truststore_password

# PostgreSQL SSL Configuration (uncomment for production)
# POSTGRES_SSL_MODE=require
# POSTGRES_SSL_CERT=/etc/ssl/certs/postgresql.crt
# POSTGRES_SSL_KEY=/etc/ssl/private/postgresql.key

# -----------------------------------------------------------------------------
# Monitoring and Observability (Optional)
# -----------------------------------------------------------------------------
# Configuration for monitoring and metrics collection

# Prometheus metrics (uncomment if using monitoring)
# PROMETHEUS_PORT=9090
# GRAFANA_PORT=3000

# Jaeger tracing (uncomment if using distributed tracing)
# JAEGER_AGENT_HOST=jaeger
# JAEGER_AGENT_PORT=6831

# -----------------------------------------------------------------------------
# Validation Notes
# -----------------------------------------------------------------------------
# Required variables that MUST be set:
# - POSTGRES_USER, POSTGRES_PASSWORD
# - PRODUCTS_SERVICE_URL, RATINGS_SERVICE_URL
# - KAFKA_ZOOKEEPER_CONNECT
#
# Optional variables with sensible defaults:
# - All port configurations
# - Logging levels
# - Health check settings