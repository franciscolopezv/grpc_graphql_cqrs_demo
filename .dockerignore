# Docker ignore file for GraphQL Gateway build

# Git files
.git
.gitignore

# Documentation
README.md
docs/

# Environment files
.env
.env.*

# Node modules (if any)
node_modules/

# Logs
*.log
logs/

# Runtime data
pids/
*.pid
*.seed

# Coverage directory used by tools like istanbul
coverage/

# Dependency directories
node_modules/

# Optional npm cache directory
.npm

# Optional REPL history
.node_repl_history

# Output of 'npm pack'
*.tgz

# Yarn Integrity file
.yarn-integrity

# Docker files (except the one we're using)
Dockerfile*
!Dockerfile.graphql-gateway
docker-compose*.yml

# IDE files
.vscode/
.idea/
*.swp
*.swo

# OS generated files
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
ehthumbs.db
Thumbs.db